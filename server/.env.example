# ===== Must match values already used by the app =====
# The admin account is seeded as: admin / admin123
# The server looks for server/.env (or the process environment / Render env vars)

# --- Authentication (REQUIRED in production) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Leave DATABASE_URL EMPTY/unset to keep using the local SQLite file
# (server/data/school.db, no changes needed). That is the default mode.
#
# Set DATABASE_URL to a PostgreSQL connection string to switch to Postgres.
# The server will use the Postgres driver and create the schema at startup
# (server/db/schema.pg.sql), then you must seed/migrate data with:
#   npm run migrate:pg
# Postgres examples:
#   DATABASE_URL=postgres://user:password@host:5432/dbname
#   DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# DATABASE_URL=

# --- Cloudinary (OPTIONAL, for images) ---
# If empty/unset, images are stored locally in server/uploads (current behavior).
# Set CLOUDINARY_URL to upload images to Cloudinary instead.
# You can copy this value from your Cloudinary dashboard:
#   Dashboard → "API Environment variable" → e.g.
#   cloudinary://123456789012345:AbC...@cloudname
CLOUDINARY_URL=